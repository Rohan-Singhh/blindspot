{
  "name": "blindspot-workspace",
  "version": "0.3.0",
  "description": "Find the problems your linters don't.",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b && node scripts/bundle-cli.mjs",
    "dev": "npm run build --silent && node packages/cli/dist/index.js",
    "test": "npm run build --silent && vitest run",
    "test:watch": "vitest"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
